// Portable default: works with local Docker (VS Code / devcontainer CLI) on Linux, macOS and
// Windows via WSL2 (open the folder from inside WSL; initializeCommand is a POSIX command), and with
// builders that ignore runArgs/mounts (e.g. Coder envbuilder). Azahar uses Mesa software
// rendering here. On a Linux host with an iGPU, or to use `3dslink -s`, pick the "linux-host"
// configuration (.devcontainer/linux-host/devcontainer.json) instead.
{
  "name": "rmxp3ds",
  "build": { "dockerfile": "Dockerfile", "context": "." },
  "remoteUser": "dev",
  "updateRemoteUserUID": true,

  // Your own game folders (never committed). initializeCommand creates the folder on the host,
  // because Docker refuses a bind mount whose source does not exist.
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/rmxp3ds-games\"",
  "mounts": [
    "source=${localEnv:HOME}/rmxp3ds-games,target=/workspaces/games,type=bind"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "Shopify.ruby-lsp",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/opt/devkitpro/devkitARM/bin/arm-none-eabi-gcc",
        "C_Cpp.default.includePath": [
          "${workspaceFolder}/**",
          "/opt/devkitpro/libctru/include",
          "/opt/devkitpro/portlibs/3ds/include"
        ],
        "C_Cpp.default.defines": ["__3DS__", "ARM11"]
      }
    }
  },

  // Seeds Azahar's settings (New 3DS model, CPU clock, renderer, audio off) from the repo, if present.
  "postCreateCommand": "arm-none-eabi-gcc --version | head -n1 && ruby -v && if [ -f .devcontainer/azahar/qt-config.ini ]; then mkdir -p ~/.config/azahar-emu && cp .devcontainer/azahar/qt-config.ini ~/.config/azahar-emu/; fi"
}
